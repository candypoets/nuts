# Ignore node_modules (reinstalled in Docker anyway)
node_modules

# Ignore build outputs (generated during build)
build
dist
.svelte-kit

# Ignore logs and temp files
*.log
.tmp
temp/

# Never send local credentials to the Docker build context.
.env
.env.*
!.env.example

# Ignore Git and editor files
.git
.gitignore
.vscode
.idea
