# Stripe Connect platform key. This is a platform credential, never a community Nostr signing key.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Dedicated server-only Nostr key used to authorize paid membership redemptions.
NUTS_PAYMENT_SERVICE_SECRET_KEY=<32-byte-hex-secret>
NUTS_PAYMENT_SERVICE_PUBKEY=<derived-hex-pubkey>

# Optional relay URL -> community HTTP service mapping for split-port/local deployments.
# Production communities normally use the same host for wss:// and https://.
NUTS_COMMUNITY_SERVICE_URLS={"ws://127.0.0.1:17777/":"http://127.0.0.1:17788"}

# Application-owned SQLite database. Persist this path on a Docker volume.
APP_DATABASE_PATH=/data/nuts.db

# Optional legacy JSON store. Existing mappings are imported into APP_DATABASE_PATH once.
STRIPE_STATE_PATH=/data/stripe-connect.json
