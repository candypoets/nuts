{
  "language_overrides": {
    "Svelte": {
      "language_servers": ["svelte-language-server", "vtsls", "eslint"],
      "format_on_save": "on"
    },
    "TypeScript": {
      "language_servers": ["vtsls", "eslint"],
      "format_on_save": "on"
    }
  },
  "lsp": {
    "svelte-language-server": {
      "binary": {
        "path": "/root/.volta/bin/node",
        "arguments": ["/root/.local/share/zed/remote_extensions/work/svelte/node_modules/svelte-language-server/bin/server.js", "--stdio"]
      },
      "settings": {
        "svelte": {
          "plugin": {
            "typescript": {
              "enabled": true
            }
          }
        }
      }
    }
  }
}
