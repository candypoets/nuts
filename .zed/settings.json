{
  "language_overrides": {
    "Svelte": {
      "language_servers": ["svelte-language-server", "vtsls", "eslint"],
      "format_on_save": "on"
    },
    "TypeScript": {
      "language_servers": ["vtsls", "eslint"],
      "format_on_save": "on"
    }
  },
  "lsp": {
    "svelte-language-server": {
      "binary": {
        "path": "/root/code/nuts-cash/node_modules/.bin/svelteserver",
        "arguments": ["--stdio"]
      },
      "settings": {
        "svelte.plugin.typescript.enabled": true,
        "svelte.plugin.svelte.enabled": true
      }
    }
  }
}
